#!/usr/bin/env bash

cd "$(dirname "$0")" || exit 1
source ./minsh-rofi-util

MENU="Show all generations|Clear older than 7 days|Clear older than 1 day|Clear all, leave current"

CHOICE=$(generate_menu "$MENU" "Generations")

collect_garbage() {
  ./minsh-splash-text

  echo
  case "$1" in
  "all") echo "Will be removed ALL generations except current" ;;
  "1") echo "Will be removed all generations OLDER than 1 day" ;;
  "7") echo "Will be removed all generations OLDER than 7 days" ;;
  *) echo "Wrong value" exit 1 ;;
  esac
  echo

  read -rp "Proceed? [y/N]: " answer
  case "$answer" in
  y | Y) ;;
  *) echo "Aborted." exit 0 ;;
  esac

  case "$1" in
  "all") sudo nix-collect-garbage -d ;;
  "1") sudo nix-collect-garbage --delete-older-than 1d ;;
  "7") sudo nix-collect-garbage --delete-older-than 7d ;;
  esac

  echo
  echo "Done. Press any key to exit."
  read -rn1
}

case "$CHOICE" in
"Show all generations") kitty -e bash -c 'nixos-rebuild list-generations | bat' ;;
"Clear older than 7 days") collect_garbage "7" ;;
"Clear older than 1 day") collect_garbage "1" ;;
"Clear all, except current") collect_garbage "all" ;;
esac
