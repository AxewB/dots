#!/usr/bin/env bash

export PATH="$HOME/.local/share/omarchy/bin:$PATH"

generate_menu() {
  local prompt="$1"
  local items="$1"
  printf "%s" "$items" | walker --dmenu --placeholder "$prompt"
}

