#!/usr/bin/env bash

cd "$(dirname "$0")" || exit 1
source ./minsh-rofi-util

HYPR_CONF="$HOME/.config/hypr/bindings.conf"
BINDINGS=""

rg "bind" "$HYPR_CONF"

get_bindings() {
  BINDINGS=$(rg "bind" "$HYPR_CONF")
  echo "$BINDINGS"
}

main() {
  get_bindings
  generate_menu "${BINDINGS[@]}" "Bindings"
}

