# Base settings
set -g set-clipboard on
set -g mouse on
set -g escape-time 0 # Remove delay for exiting insert mode with ESC in Neovim
set -g status-interval 3
set -g detach-on-destroy off
#

## Enable 256-color and true-color (24-bit) support in tmux
set -g default-terminal "screen-256color"
set -ga terminal-overrides ",*256col*:Tc"

# change prefix
unbind C-b
set -g prefix C-s
set -g prefix2 C-l

set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on

# : Base binds
# panes
unbind %
unbind '"'
unbind x
unbind c
bind C-v split-window -v -c "#{pane_current_path}"
bind C-h split-window -h -c "#{pane_current_path}"
bind C-x kill-pane
bind C-c new-window -c "#{pane_current_path}"

# config reload
unbind r
bind r source-file ~/.config/tmux/tmux.conf \; display "Reloaded"

bind -r h resize-pane -L 10
bind -r j resize-pane -D 10
bind -r k resize-pane -U 10
bind -r l resize-pane -R 10
bind -r m resize-pane -Z # Z key to maximize pane 

# use vi mode
set-window-option -g mode-keys vi
set -g status-keys vi

# vim style copy paste mode
unbind [
# bind C-space copy-mode
# bind Escape copy-mode \; send -X begin-selection
bind Escape copy-mode 
bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi y send -X copy-selection
bind -T copy-mode-vi Escape send -X cancel
bind -T copy-mode-vi = send -X start-of-line

bind -T copy-mode-vi Escape if-shell -F "#{?selection_present,1,0}" \
    "send -X clear-selection" \
    "send -X cancel"

# Remove copy by mouse selecting
unbind -T copy-mode-vi MouseDragEnd1Pane 

# set -g status-position top

# --- 

# vim status line integration into tmux
set -g focus-events on
set -g status-style bg=default
set -g status-left '#(cat #{socket_path}-\#{session_id}-vimbridge)'
set -g status-left-length 99
set -g status-right '#(cat #{socket_path}-\#{session_id}-vimbridge-R)'
set -g status-right-length 99
set -g status-justify centre

set -g focus-events on
set -g status-style bg=default
set -g status-left-length 99
set -g status-right-length 99
set -g status-justify centre


set -g window-status-current-format "#[bg=#b4befe]#[fg=#11111b] #I #[bg=#45475a]#[fg=#cdd6f4] #W "
set -g window-status-format "#[bg=#45475a]#[fg=#cdd6f4] #I #[bg=#313244]#[fg=#cdd6f4] #W "

# yazi requirement to be able to draw images in tmux session 
set -g allow-passthrough on
set -ga update-environment TERM
set -ga update-environment TERM_PROGRAM

# ---
# List of plugins

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'

# vim integration
set -g @plugin 'christoomey/vim-tmux-navigator' # Enable navigating between nvim and tmux
set -g @plugin 'tmux-plugins/tmux-resurrect'    # Persist tmux sessions after computer restart 
set -g @plugin 'tmux-plugins/tmux-continuum'    # Automatically saves sessions every 15 minutes

# cpu mem load
set -g @plugin 'thewtex/tmux-mem-cpu-load'

# ---
# Initialize TPM (keep this line at the very bottom of tmux.conf)
run '~/.tmux/plugins/tpm/tpm'
