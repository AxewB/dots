{
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "show_edit_predictions": false,
  "minimap": {
    "show": "never"
  },
  "cursor_shape": "bar",
  "show_whitespaces": "none",
  "edit_predictions": {
    "mode": "eager",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
    "enabled_in_text_threads": false
  },
  "scrollbar": {
    "git_diff": true,
    "selected_symbol": false,
    "selected_text": false
  },
  "bottom_dock_layout": "contained",
  "terminal": {
    "blinking": "off",
    "line_height": "standard",
    // "font_family": "CaskaydiaCove Nerd Font Mono",
    // "font_family": "ZedMono Nerd Font",
    "font_size": 14,
    "dock": "bottom",
    "copy_on_select": true,
    "detect_venv": {
      "on": {
        "directories": [".env", "env", ".venv", "venv"],
        "activate_script": "default"
      }
    }
  },
  "agent": {
    "play_sound_when_agent_done": true,
    "use_modifier_to_send": true,
    "dock": "right",
    "always_allow_tool_actions": true,
    "default_profile": "write",
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4"
    }
  },
  "features": {
    "edit_prediction_provider": "zed"
  },
  "icon_theme": "Catppuccin Mocha",
  "vim_mode": true,
  "vim": {
    "highlight_on_yank_duration": 100,
    "toggle_relative_line_numbers": true,
    "use_system_clipboard": "always",
    "use_multiline_find": true,
    "use_smartcase_find": true
  },
  "scroll_beyond_last_line": "one_page",
  "ui_font_size": 16,
  "buffer_font_size": 20,
  "agent_ui_font_size": 16,
  // "buffer_line_height": {
  //   "custom": 1.5
  // },

  "buffer_line_height": "standard",

  // "ui_font_family": "JetBrainsMono Nerd Font Mono",
  // "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "ui_font_family": "CaskaydiaMono Nerd Font Mono",
  "buffer_font_family": "CaskaydiaMono Nerd Font Mono",
  // "ui_font_family": "Iosevka Nerd Font",
  // "buffer_font_family": "Iosevka Nerd Font",
  "lsp_highlight_debounce": 5,
  // "ui_font_weight": 600,
  // "buffer_font_weight": 600,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Mocha",
    "dark": "0x96f Theme"
  },
  "active_pane_modifiers": {
    "border_size": 2.0
  },
  "autosave": "off",
  "vertical_scroll_margin": 999,
  "horizontal_scroll_margin": 999,
  "current_line_highlight": "gutter",
  "relative_line_numbers": "enabled",
  "toolbar": {
    "agent_review": false,
    "code_actions": false,
    "quick_actions": false,
    "selections_menu": false,
    "breadcrumbs": true
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  },
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": true,
    "activate_on_close": "history",
    "show_close_button": "hover",
    "show_diagnostics": "errors"
  },
  "cursor_blink": false,
  "diagnostics": {
    "include_warnings": true
  },
  "soft_wrap": "none",
  "project_panel": {
    "button": true,
    "default_width": 240,
    "dock": "left",
    "entry_spacing": "standard",
    "file_icons": true,
    "folder_icons": false,
    "git_status": true,
    "indent_size": 30,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true,
    "scrollbar": {
      "show": null
    },
    "show_diagnostics": "all",
    "indent_guides": {
      "show": "always"
    }
  },
  "indent_guides": {
    "enabled": true,
    "line_width": 4,
    "active_line_width": 4,
    "coloring": "fixed",
    "background_coloring": "disabled"
  },
  "gutter": {
    "line_numbers": true,
    "folds": false,
    "code_actions": false,
    "symbols": false,
    "breakpoints": false,
    "runnables": false
  },
  "tab_size": 2,
  "journal": {
    "hour_format": "hour24"
  },
  "file_finder": {
    "modal_max_width": "medium"
  },
  "completions": {
    // "words": "enabled"
    "words": "fallback"
  },
  // wraps
  // "wrap_guides": [80],
  // "show_wrap_guides": true,
  "inlay_hints": {
    "enabled": false,
    "show_type_hints": false,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": true,
    "edit_debounce_ms": 400,
    "scroll_debounce_ms": 50,
    "toggle_on_modifiers_press": null
  },
  "jupyter": {
    "kernel_selections": {
      "python": ".venv",
      "typescript": "deno",
      "javascript": "deno",
      "r": "ark"
    }
  },
  "auto_install_extensions": {
    "qml": true,
    "html": true,
    "catppuccin": true,
    "catppuccin-icons": true,
    "csharp": true,
    "csv": true,
    "docker-compose": true,
    "dockerfile": true,
    "hyprlang": true,
    "ini": true,
    "kotlin": true,
    "latex": true,
    "lua": true,
    "macos-classic": true,
    "python-requirements": true,
    "rainbow-csv": true,
    "scss": true,
    "sql": true,
    "vue": true,
    "xml": true,
    "typst": true
  },
  "languages": {
    "Typst": { "tab_size": 2 },
    "MATLAB": {
      "tab_size": 4
    },
    "C++": {
      "format_on_save": "on"
    },
    "C": {
      "format_on_save": "on"
    },
    "CSV": {
      "format_on_save": "off"
    },
    "Java": {
      "tab_size": 4
    },
    "Python": {
      "tab_size": 4,
      "preferred_line_length": 1000,
      "language_servers": ["pyright", "ruff"], // ruff
      "format_on_save": "on",
      "formatter": [
        {
          "language_server": {
            "name": "ruff"
          }
        }
      ]
    },
    "Markdown": {
      "formatter": "prettier",
      "format_on_save": "on",
      "remove_trailing_whitespace_on_save": true,
      "allow_rewrap": "anywhere",
      "soft_wrap": "none"
    },
    "Shell Script": {
      "tab_size": 4
    },
    "QML": {
      "show_edit_predictions": false,
      "tab_size": 4,
      "formatter": {
        "external": {
          // qmlls default formatter
          // "command": "qmlformat",
          // "arguments": ["{buffer_path}", "-n"]

          "command": "qmlfmt",
          // "arguments": ["-t", "2", "-i", "2", "{buffer_path}"]
          "arguments": ["{buffer_path}"]
        }
      },
      "format_on_save": "off"
    },
    "LaTeX": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--write", "--stdin-filepath", "{buffer_path}"]
        }
      },
      "tab_size": 4,
      "auto_indent_on_paste": false,
      // "soft_wrap": "bounded",
      "format_on_save": "on"
    }
  },
  "lsp": {
    "qmlls": {
      "enable_lsp_tasks": true
    },
    "ltex": {
      "settings": {
        "ltex": {
          "language": "ru-RU"
        }
      }
    },
    "vtsls": {
      "settings": {
        // For JavaScript:
        "javascript": {
          "inlayHints": {
            "parameterNames": {
              "enabled": "all",
              "suppressWhenArgumentMatchesName": false
            },
            "parameterTypes": {
              "enabled": true
            },
            "variableTypes": {
              "enabled": true,
              "suppressWhenTypeMatchesName": true
            },
            "propertyDeclarationTypes": {
              "enabled": true
            },
            "functionLikeReturnTypes": {
              "enabled": true
            },
            "enumMemberValues": {
              "enabled": true
            }
          }
        },
        // For TypeScript:
        "typescript": {
          "inlayHints": {
            "parameterNames": {
              "enabled": "all",
              "suppressWhenArgumentMatchesName": false
            },
            "parameterTypes": {
              "enabled": true
            },
            "variableTypes": {
              "enabled": true,
              "suppressWhenTypeMatchesName": true
            },
            "propertyDeclarationTypes": {
              "enabled": true
            },
            "functionLikeReturnTypes": {
              "enabled": true
            },
            "enumMemberValues": {
              "enabled": true
            }
          }
        }
      }
    },
    "pyright": {
      "settings": {
        "python.analysis": {
          // "diagnosticMode": "workspace",
          // "typeCheckingMode": "strict"
        },
        "python": {
          "pythonPath": ".venv/bin/python"
        }
      }
    }
  }
}
