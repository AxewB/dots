{
  "nvim add plugin": {
    "prefix": "nvim add plugin",
    "body": ["vim.pack.add({", "  { src = \"https://github.com/${1}\" },", "})"]
  },
  "nvim add dependency": {
    "prefix": "nvim add dependency",
    "body": ["{ src = \"https://github.com/${1}\" },"]
  },
  "stylua-ignore-block": {
    "prefix": "Add stylua ignore block",
    "body": [
      "-- stylua: ignore start",
      "${1}",
      "-- stylua: ignore end"
    ]
  }
}
