[STYLE]
# start flavours
base00 = #{{base00-hex}}
base01 = #{{base01-hex}}
base02 = #{{base02-hex}}
base03 = #{{base03-hex}}
base04 = #{{base04-hex}}
base05 = #{{base05-hex}}
base06 = #{{base06-hex}}
base07 = #{{base07-hex}}
base08 = #{{base08-hex}}
base09 = #{{base09-hex}}
base0a = #{{base0a-hex}}
base0b = #{{base0b-hex}}
base0c = #{{base0c-hex}}
base0d = #{{base0d-hex}}
base0e = #{{base0e-hex}}
base0f = #{{base0f-hex}}
# end flavours
font = 12pt Monospace
image.bg = #{{base00-hex}}
image.scrollbar.width = 8px
image.scrollbar.bg = #{{base00-hex}}
image.scrollbar.fg = #{{base03-hex}}
image.scrollbar.padding = 2px
library.font = 10pt Monospace
library.fg = #{{base06-hex}}
library.padding = 2px
library.directory.fg = #{{base07-hex}}
library.even.bg = #{{base01-hex}}
library.odd.bg = #{{base01-hex}}
library.selected.bg = #{{base0d-hex}}
library.selected.fg = #{{base07-hex}}
library.search.highlighted.fg = #{{base01-hex}}
library.search.highlighted.bg = #{{base04-hex}}
library.scrollbar.width = 8px
library.scrollbar.bg = #{{base00-hex}}
library.scrollbar.fg = #{{base03-hex}}
library.scrollbar.padding = 2px
library.border = 0px solid
statusbar.font = 10pt Monospace
statusbar.bg = #{{base02-hex}}
statusbar.fg = #{{base06-hex}}
statusbar.error = #{{base08-hex}}
statusbar.warning = #{{base09-hex}}
statusbar.info = #{{base0c-hex}}
statusbar.message_border = 2px solid
statusbar.padding = 4
thumbnail.font = 10pt Monospace
thumbnail.fg = #{{base06-hex}}
thumbnail.bg = #{{base00-hex}}
thumbnail.padding = 20
thumbnail.selected.bg = #{{base0d-hex}}
thumbnail.search.highlighted.bg = #{{base04-hex}}
thumbnail.default.bg = #{{base0c-hex}}
thumbnail.error.bg = #{{base08-hex}}
thumbnail.frame.fg = #{{base06-hex}}
completion.height = 16em
completion.fg = #{{base06-hex}}
completion.even.bg = #{{base02-hex}}
completion.odd.bg = #{{base02-hex}}
completion.selected.fg = #{{base07-hex}}
completion.selected.bg = #{{base0d-hex}}
keyhint.padding = 2px
keyhint.border_radius = 10px
keyhint.suffix_color = #{{base0c-hex}}
manipulate.fg = #{{base06-hex}}
manipulate.focused.fg = #{{base0c-hex}}
manipulate.bg = #{{base00-hex}}
manipulate.slider.left = #{{base0d-hex}}
manipulate.slider.handle = #{{base04-hex}}
manipulate.slider.right = #{{base02-hex}}
manipulate.image.border = 2px solid
manipulate.image.border.color = #{{base0c-hex}}
mark.color = #{{base0e-hex}}
keybindings.bindings.color = #{{base0c-hex}}
keybindings.highlight.color = #{{base0e-hex}}
metadata.padding = 2px
metadata.border_radius = 10px
image.straighten.color = #{{base0a-hex}}
prompt.font = 10pt Monospace
prompt.fg = #{{base06-hex}}
prompt.bg = #{{base02-hex}}
prompt.padding = 2px
prompt.border_radius = 10px
prompt.border = 2px solid
prompt.border.color = #{{base0c-hex}}
crop.shading = #88000000
crop.border = 2px solid
crop.border.color = #88AAAAAA
crop.grip.color = #88FFFFFF
crop.grip.border = 2px solid
crop.grip.border.color = #88AAAAAA
library.selected.bg.unfocus = #8881a2be
thumbnail.selected.bg.unfocus = #8881a2be
metadata.bg = #AAd6d6d6

; vim:ft=dosini
